# Скопируйте в .env и заполните своими значениями (.env в git не коммитится).

# База API (фронтенд)
REACT_APP_API_HOST=
REACT_APP_API_PORT=
REACT_APP_API_BASE=/api

# Ключ Yandex Weather (если используется хук useYandexWeather)
REACT_APP_YANDEX_KEY=

# Токен Telegram-бота задаётся НЕ здесь, а через systemd drop-in бота:
#   /etc/systemd/system/pokrovka-bot.service.d/secrets.conf
#   [Service]
#   Environment=TELEGRAM_TOKEN=xxxxx
